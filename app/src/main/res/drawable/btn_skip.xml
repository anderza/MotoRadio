<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- внешнее кольцо -->
    <item>
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="#363A45" android:endColor="#2A2D37" />
        </shape>
    </item>
    <!-- тёмный «колодец» -->
    <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="#16181D" />
        </shape>
    </item>
    <!-- выпуклая кнопка -->
    <item android:bottom="8dp" android:left="8dp" android:right="8dp" android:top="8dp">
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="#444957" android:endColor="#323641" />
            <stroke android:width="1dp" android:color="#22FFFFFF" />
        </shape>
    </item>
</layer-list>
