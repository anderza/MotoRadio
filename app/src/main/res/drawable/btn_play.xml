<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- внешнее кольцо -->
    <item>
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="#363A45" android:endColor="#2A2D37" />
        </shape>
    </item>
    <!-- тёмный «колодец» -->
    <item android:bottom="6dp" android:left="6dp" android:right="6dp" android:top="6dp">
        <shape android:shape="oval">
            <solid android:color="#16181D" />
        </shape>
    </item>
    <!-- выпуклая кнопка -->
    <item android:bottom="11dp" android:left="11dp" android:right="11dp" android:top="11dp">
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="#5D6371" android:endColor="#3C414D" />
            <stroke android:width="1dp" android:color="#22FFFFFF" />
        </shape>
    </item>
</layer-list>
