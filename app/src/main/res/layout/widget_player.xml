<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет в стиле нижнего проигрывателя: обложка с винилом, исполнитель, песня, статус и круглые кнопки -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <!-- Обложка и выглядывающий из-за неё винил -->
    <FrameLayout
        android:layout_width="104dp"
        android:layout_height="96dp">

        <ImageView
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_gravity="end|center_vertical"
            android:importantForAccessibility="no"
            android:src="@drawable/vinyl" />

        <ImageView
            android:id="@+id/w_cover"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/cover_shadow"
            android:contentDescription="@string/open_app"
            android:padding="1dp"
            android:scaleType="centerCrop"
            android:src="@drawable/cover_placeholder" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/w_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="MotoRadio"
                android:textColor="#F5D5A6"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/pick_station"
                android:textColor="#C6CADF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/w_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:text="[—]"
                android:textColor="#7F8498"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="4dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/divider" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/w_reconnect"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/btn_round"
                android:contentDescription="@string/reconnect"
                android:scaleType="center"
                android:src="@drawable/ic_w_replay" />

            <ImageButton
                android:id="@+id/w_prev"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="3dp"
                android:background="@drawable/btn_skip"
                android:contentDescription="@string/prev"
                android:scaleType="center"
                android:src="@drawable/ic_w_prev" />

            <ImageButton
                android:id="@+id/w_play"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/btn_play"
                android:contentDescription="@string/play_pause"
                android:scaleType="center"
                android:src="@drawable/ic_w_play" />

            <ImageButton
                android:id="@+id/w_next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/btn_skip"
                android:contentDescription="@string/next"
                android:scaleType="center"
                android:src="@drawable/ic_w_next" />

            <ImageButton
                android:id="@+id/w_shuffle"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="3dp"
                android:background="@drawable/btn_round"
                android:contentDescription="@string/shuffle"
                android:scaleType="center"
                android:src="@drawable/ic_w_shuffle" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
